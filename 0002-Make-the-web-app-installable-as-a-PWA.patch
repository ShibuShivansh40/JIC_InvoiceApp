From b810036d1c3016a4611007093874e9c3f898d122 Mon Sep 17 00:00:00 2001
From: Shivansh Seth <82285859+ShibuShivansh40@users.noreply.github.com>
Date: Wed, 30 Sep 2026 03:25:02 +0000
Subject: [PATCH] Make the web app installable as a PWA

- Copy public/ into dist/ via copy-webpack-plugin (manifest.json was 404 on Amplify)
- Add the app icons the manifest references (192, 512, maskable, apple-touch, favicon)
- Add a minimal service worker (network-first pages, cached static assets,
  API calls untouched) and register it in production builds
- Add id/scope/description to the manifest and point apple-touch-icon at a 180px icon

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01WREhoqRSdivyxanxt8x7DL
---
 index.html                  |   4 ++-
 index.web.js                |   9 ++++++
 package-lock.json           |  35 +++++++++++++++++++++
 package.json                |   1 +
 public/apple-touch-icon.png | Bin 0 -> 2863 bytes
 public/favicon.png          | Bin 0 -> 909 bytes
 public/icon-192.png         | Bin 0 -> 3033 bytes
 public/icon-512.png         | Bin 0 -> 8168 bytes
 public/manifest.json        |  17 +++++++++--
 public/sw.js                |  59 ++++++++++++++++++++++++++++++++++++
 webpack.config.js           |   5 +++
 11 files changed, 126 insertions(+), 4 deletions(-)
 create mode 100644 public/apple-touch-icon.png
 create mode 100644 public/favicon.png
 create mode 100644 public/icon-192.png
 create mode 100644 public/icon-512.png
 create mode 100644 public/sw.js

diff --git a/index.html b/index.html
index f41e55c..06a289c 100644
--- a/index.html
+++ b/index.html
@@ -6,12 +6,14 @@
   <title>Jai Industrial Corp - Invoice App</title>
 
   <!-- PWA & iOS Safari Meta Tags -->
+  <meta name="mobile-web-app-capable" content="yes">
   <meta name="apple-mobile-web-app-capable" content="yes">
   <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
   <meta name="apple-mobile-web-app-title" content="JIC Invoices">
   <meta name="theme-color" content="#007AFF">
   <link rel="manifest" href="/manifest.json">
-  <link rel="apple-touch-icon" href="/icon-192.png">
+  <link rel="icon" type="image/png" href="/favicon.png">
+  <link rel="apple-touch-icon" href="/apple-touch-icon.png">
 
   <style>
     /* Reset and fullscreen setup for iOS PWA */
diff --git a/index.web.js b/index.web.js
index 991e553..18f8230 100644
--- a/index.web.js
+++ b/index.web.js
@@ -76,6 +76,15 @@ const RootApp = () => (
   </WebErrorBoundary>
 );
 
+// Register the service worker (production only, so dev builds never serve stale code)
+if (process.env.NODE_ENV === 'production' && 'serviceWorker' in navigator) {
+  window.addEventListener('load', () => {
+    navigator.serviceWorker.register('/sw.js').catch((err) => {
+      console.log('Service worker registration failed:', err);
+    });
+  });
+}
+
 // Register and launch app
 AppRegistry.registerComponent('InvoiceApp', () => RootApp);
 AppRegistry.runApplication('InvoiceApp', {
